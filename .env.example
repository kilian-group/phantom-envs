# Copy to .env (gitignored) and uncomment what you need; scripts/skyrl/launch_skyrl.sh reads it.

# W&B logging for training runs (evals log to the console). Without W&B, train with trainer.logger=console.
# WANDB_API_KEY=
# WANDB_ENTITY=
# WANDB_PROJECT=

# Where checkpoints and HF exports go (default: this repo).
# RUN_BASE_DIR=/path/to/runs

# HuggingFace cache (default: ~/.cache/huggingface).
# HF_HOME=/path/to/huggingface

# Conda env with faiss-gpu, used by the retriever only with retriever.faiss_gpu=true (Search-R1's
# 21M-doc index; see reproduce_paper/README.md). Every other corpus uses the faiss-cpu wheel.
# FAISS_GPU_ENV=/path/to/conda/envs/phantom-envs-faiss-gpu
